@namespace BootstrapBlazor.Components
@inherits BootstrapComponentBase

<nav @attributes="@AdditionalAttributes" aria-label="breadcrumb">
    <ol class="breadcrumb">
        <CascadingValue Value="this" IsFixed="true">
            @foreach (var (item, index) in Value.Select((v, i) => (v, i)))
            {
                @if (index > 0)
                {
                    <li class="breadcrumb-divider"></li>
                }
                @RenderItem(item)
            }
        </CascadingValue>
    </ol>
</nav>

@code {
    RenderFragment<BreadcrumbItem> RenderItem => item =>
    @<li class="@GetItemClassString(item)" aria-current="@GetAriaCurrent(item)">
        @if (!string.IsNullOrEmpty(item.Url))
        {
            <a class="@GetLinkClassString(item)" href="@item.Url">@item.Text</a>
        }
        else
        {
            <span class="@GetLinkClassString(item)">@item.Text</span>
        }
    </li>;
}
