@namespace BootstrapBlazor.Components
@typeparam TValue
@inherits BootstrapInputNumberBase<TValue>
@attribute [BootstrapModuleAutoLoader]

@if (IsShowLabel)
{
    <BootstrapLabel Value="@DisplayText" ShowLabelTooltip="ShowLabelTooltip" for="@Id" />
}

<div class="@WrapperClassString">
    <input @attributes="@AdditionalAttributes" type="range" id="@Id" class="@ClassString" disabled="@IsDisabled" @bind-value="CurrentValueAsString" @bind-value:event="@EventString" step="@StepString" min="@MinString" max="@MaxString" list="@ListId" @onblur="OnBlur">
    @if (HasTicks)
    {
        <datalist id="@ListId">
            @foreach (var tick in _ticks)
            {
                <option value="@tick"></option>
            }
        </datalist>
    }
</div>
