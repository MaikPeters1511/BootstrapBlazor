@page "/password-strength"
@inject IStringLocalizer<PasswordStrengths> Localizer

<h3>@Localizer["PasswordStrengthsTitle"]</h3>

<h4>@Localizer["PasswordStrengthsDescription"]</h4>

<DemoBlock Title="@Localizer["PasswordStrengthsNormalTitle"]"
           Introduction="@Localizer["PasswordStrengthsNormalIntro"]"
           Name="Normal">
    <div class="row g-3">
        <div class="col-12 sm:col-6">
            <BootstrapPassword Id="password_strength_normal" DisplayText="@Localizer["PasswordStrengthsPassword"]" ShowLabel="true" />
            <PasswordStrength InputId="password_strength_normal" OnStrengthChanged="OnStrengthChanged" />
        </div>
        <div class="col-12 sm:col-6 d-flex align-items-end">
            <span>@Localizer["PasswordStrengthsLevel"]: @_level</span>
        </div>
    </div>
</DemoBlock>

<DemoBlock Title="@Localizer["PasswordStrengthsOptionsTitle"]"
           Introduction="@Localizer["PasswordStrengthsOptionsIntro"]"
           Name="Options">
    <div class="row g-3">
        <div class="col-12 sm:col-6">
            <BootstrapPassword Id="password_strength_options" DisplayText="@Localizer["PasswordStrengthsPassword"]" ShowLabel="true" />
            <PasswordStrength InputId="password_strength_options" MinLength="12" ShowText="false" />
        </div>
    </div>
</DemoBlock>

<AttributeTable Type="typeof(PasswordStrength)" />
